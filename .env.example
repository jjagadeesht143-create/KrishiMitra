# KrishiMitra example settings (Phase 2, Mock-only, $0 cost). Copy
# these keys to your real .env file by hand and fill values only
# from official Meta docs. NEVER commit the real .env file.
# No real keys or URLs here - Mock Mode stays on while empty.
# No real httpx call happens in Mock Mode. Never print keys.
APP_ENV=development
# Phase 2: MODEL_API_KEY wins, else META_API_KEY, else "" (Mock Mode).
# Keep both empty for free safe testing. Fill only from official docs.
MODEL_API_KEY=
META_API_KEY=
# Phase 2: full Meta endpoint from official docs. Empty = Mock Mode.
# Verified 2026-11-04 at https://dev.meta.ai/docs (Meta Model API):
# base https://api.meta.ai/v1, chat https://api.meta.ai/v1/chat/completions.
# Paste the FULL chat URL here only from those docs. Empty = $0, no API call.
META_API_BASE_URL=
# Phase 2: example model name only. No call happens while Mock Mode is on.
META_MODEL_NAME=muse-spark-1.3
# Phase 2: true = safe Mock Mode (free testing, no API call).
# Set to false only when real Meta access is configured above.
USE_MOCK_AI=true
# Phase 2-3: seconds to wait for one Meta AI reply (default 30).
AI_TIMEOUT_SECONDS=30
# Phase 5: Meta WhatsApp Cloud API only (no Twilio). Copy to .env by hand,
# fill only from the Meta App Dashboard / official Meta docs. Never commit .env.
# WHATSAPP_TOKEN: token from Meta App Dashboard > WhatsApp > API Setup. Empty = mock, no call.
WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID: test or business phone number ID from the same page. Empty = mock.
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_BUSINESS_ACCOUNT_ID: WhatsApp Business Account ID from Meta App Dashboard. Empty = not configured.
WHATSAPP_BUSINESS_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN: your own verify string for GET webhook. Code default test123 when empty/missing.
WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET: App Secret from Meta App Dashboard > App settings. Empty = signature check off.
WHATSAPP_APP_SECRET=
# WHATSAPP_API_VERSION: Graph API version. Default v21.0. Change only per official Meta docs.
WHATSAPP_API_VERSION=v21.0
# Phase 7: Meta Muse Voice Transcribe (no Whisper). Copy to .env by hand,
# fill only from official Meta docs. Empty = safe Mock Mode, no API call.
META_VOICE_API_KEY=
META_VOICE_API_BASE_URL=
META_VOICE_MODEL_NAME=
# Phase 8: Meta vision for crop photos (SAM only if officially supported).
# Each empty value falls back to the shared chat credentials above
# (same verified endpoint/key/model); Mock Mode only when BOTH are empty.
# Fill these only to use different vision credentials (official docs only).
# Verified 2026-11-04 at https://dev.meta.ai/docs/image-understanding:
# same base https://api.meta.ai/v1, image sent inline as base64 data URL.
META_IMAGE_API_KEY=
META_IMAGE_API_BASE_URL=
META_IMAGE_MODEL_NAME=
# Phase 10: weather uses Open-Meteo (verified docs, free, no key).
# Override only if Open-Meteo changes its endpoints.
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_GEOCODE_URL=https://geocoding-api.open-meteo.com/v1/search
# Phase 10: mandi uses data.gov.in (free key). Official API help page was
# unreachable, so fill BOTH by hand from data.gov.in. Empty = "unavailable".
MANDI_API_BASE_URL=
MANDI_API_KEY=
